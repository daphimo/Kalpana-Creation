    { "type": "image_picker", "id": "tiktok_icon", "label": "TikTok PNG" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "header", "content": "X / Twitter" },
    { "type": "image_picker", "id": "twitter_icon", "label": "X / Twitter PNG" },
    { "type": "url", "id": "twitter_url", "label": "X / Twitter URL" },
    { "type": "header", "content": "Threads" },
    { "type": "image_picker", "id": "threads_icon", "label": "Threads PNG" },
    { "type": "url", "id": "threads_url", "label": "Threads URL" },
    { "type": "header", "content": "LinkedIn" },
    { "type": "image_picker", "id": "linkedin_icon", "label": "LinkedIn PNG" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL" },
    { "type": "header", "content": "Bluesky" },
    { "type": "image_picker", "id": "bluesky_icon", "label": "Bluesky PNG" },
    { "type": "url", "id": "bluesky_url", "label": "Bluesky URL" },
    { "type": "header", "content": "Snapchat" },
    { "type": "image_picker", "id": "snapchat_icon", "label": "Snapchat PNG" },
    { "type": "url", "id": "snapchat_url", "label": "Snapchat URL" },
    { "type": "header", "content": "Pinterest" },
    { "type": "image_picker", "id": "pinterest_icon", "label": "Pinterest PNG" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" },
    { "type": "header", "content": "Tumblr" },
    { "type": "image_picker", "id": "tumblr_icon", "label": "Tumblr PNG" },
    { "type": "url", "id": "tumblr_url", "label": "Tumblr URL" },
    { "type": "header", "content": "Vimeo" },
    { "type": "image_picker", "id": "vimeo_icon", "label": "Vimeo PNG" },
    { "type": "url", "id": "vimeo_url", "label": "Vimeo URL" }
  ],
  "presets": [
    {
      "name": "Social media links (PNG)",
      "category": "Footer"
    }
  ]
}
{% endschema %}
