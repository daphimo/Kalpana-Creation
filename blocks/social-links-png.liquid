<div
  class="social-png-icons social-png-icons--{{ block.id }}"
  style="--social-png-size: {{ block.settings.icon_size }}px; --social-png-gap: {{ block.settings.icon_gap }}px;"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign social_links = 'facebook_url,instagram_url,whatsapp_url,youtube_url,tiktok_url,twitter_url,threads_url,linkedin_url,bluesky_url,snapchat_url,pinterest_url,tumblr_url,vimeo_url' | split: ','
  %}

  {% for link_key in social_links %}
    {% liquid
      assign link_url = block.settings[link_key]
      assign platform = link_key | remove: '_url'
      if link_key == 'whatsapp_url'
        if block.settings.whatsapp_link_type == 'community'
          assign link_url = block.settings.whatsapp_community_url
        elsif link_url != blank
          unless link_url contains '://'
            assign whatsapp_number = link_url | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
            assign link_url = 'https://wa.me/' | append: whatsapp_number
          endunless
        endif
      endif
      assign icon_key = platform | append: '_icon'
      assign icon_image = block.settings[icon_key]
      assign url_parts = link_url | split: '//' | last | split: '/'
      assign has_profile = false
      if url_parts.size > 1 and url_parts[1] != ''
        assign has_profile = true
      endif
    %}

    {% if link_url != blank and icon_image != blank %}
      {% if request.design_mode or has_profile %}
        <a
          class="social-png-icons__link{% unless has_profile %} social-png-icons__link--disabled{% endunless %}"
          href="{{ link_url }}"
          {% if block.settings.link_target == 'new_tab' %}target="_blank" rel="noopener noreferrer"{% endif %}
          aria-label="{{ platform | capitalize }}"
          {% unless has_profile %}
            {% if request.design_mode %}onclick="return false;" aria-disabled="true"{% endif %}
          {% endunless %}
        >
          {{
            icon_image
            | image_url: width: 128
            | image_tag:
              class: 'social-png-icons__icon',
              loading: 'lazy',
              widths: '32, 48, 64, 96, 128',
              sizes: '48px',
              alt: ''
          }}
        </a>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .social-png-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--social-png-gap);
    color: var(--color-utilities, var(--color-foreground));
  }

  .social-png-icons__link {
    display: grid;
    width: max(44px, var(--social-png-size));
    height: max(44px, var(--social-png-size));
    place-items: center;
    color: inherit;
    text-decoration: none;
  }

  .social-png-icons__icon {
    display: block;
    width: var(--social-png-size);
    height: var(--social-png-size);
    object-fit: contain;
  }

  .social-png-icons__link:hover .social-png-icons__icon {
    opacity: 0.72;
  }

  .social-png-icons__link:focus-visible {
    border-radius: 2px;
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .shopify-design-mode .social-png-icons__link--disabled {
    opacity: var(--disabled-opacity, 0.5);
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .social-png-icons { justify-content: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social media links (PNG)",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_gap", "label": "Icon gap", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "select", "id": "link_target", "label": "Open links", "options": [{ "value": "same_tab", "label": "Normally (same tab)" }, { "value": "new_tab", "label": "In a new tab" }], "default": "new_tab" },
    { "type": "paragraph", "content": "Upload transparent PNG icons. Icons display using their original colors." },
    { "type": "header", "content": "Facebook" },
    { "type": "image_picker", "id": "facebook_icon", "label": "Facebook PNG" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
