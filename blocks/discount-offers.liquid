{% render 'brand-colors' %}
{{ 'block-discount-offers.css' | asset_url | stylesheet_tag }}

{% capture discount_cards %}
  {% for discount_number in (1..10) %}
    {% assign title_key = 'discount_title_' | append: discount_number %}
    {% assign description_key = 'discount_description_' | append: discount_number %}
    {% assign code_key = 'discount_code_' | append: discount_number %}
    {% assign discount_title = block.settings[title_key] %}
    {% assign discount_description = block.settings[description_key] %}
    {% assign discount_code = block.settings[code_key] %}
    {% if discount_title != blank or discount_description != blank or discount_code != blank %}
      <li class="product-discounts__slide"><article class="discount-card">
        <div class="discount-card__content">
          {% if discount_title != blank %}
            <h3 class="discount-card__title">{{ discount_title | escape }}</h3>
          {% endif %}
          {% if discount_description != blank %}
            <p class="discount-card__description">{{ discount_description | escape | newline_to_br }}</p>
          {% endif %}
        </div>
        {% if discount_code != blank %}
          <div class="discount-card__code-wrap">
            <span class="discount-card__code">{{ discount_code | escape }}</span>
            <button class="discount-card__copy" type="button" aria-label="Copy discount code {{ discount_code | escape }}">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                <rect x="7" y="7" width="9" height="9" rx="1.5"></rect>
                <path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-7A1.5 1.5 0 0 0 3 5.5v7A1.5 1.5 0 0 0 4.5 14H7"></path>
              </svg>
              <span>Copy</span>
            </button>
          </div>
        {% endif %}
      </article></li>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% assign visible_cards = discount_cards | strip %}
{% assign show_header = false %}
{% if block.settings.show_accent_title and block.settings.accent_title != blank %}
  {% assign show_header = true %}
{% endif %}
{% if block.settings.show_main_title and block.settings.main_title != blank %}
  {% assign show_header = true %}
{% endif %}
{% if visible_cards != blank or request.design_mode %}
  <div id="ProductDiscounts-{{ block.id }}" class="product-discounts" style="--discount-margin-top: {{ block.settings.margin_top }}px; --discount-margin-bottom: {{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
    {% if show_header %}
      <div class="product-discounts__header">
        {% if block.settings.show_accent_title and block.settings.accent_title != blank %}
          <p class="product-discounts__eyebrow">{{ block.settings.accent_title | escape }}</p>
        {% endif %}
        {% if block.settings.show_main_title and block.settings.main_title != blank %}
          <h2 class="product-discounts__heading">{{ block.settings.main_title | escape }}</h2>
        {% endif %}
      </div>
    {% endif %}
    {% if visible_cards != blank %}
      <script src="{{ 'block-discount-offers.js' | asset_url }}" defer></script>
      <div class="product-discounts__slider" data-discount-slider role="region" aria-label="Discount offers" tabindex="0">
        <ul class="product-discounts__list" role="list">{{ discount_cards }}</ul>
      </div>
    {% elsif request.design_mode %}
      <p class="product-discounts__empty">Add a discount title, description, or code in the block settings.</p>
    {% endif %}
  </div>
{% endif %}

