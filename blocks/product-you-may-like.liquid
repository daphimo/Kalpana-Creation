{{ 'cust-splide-core.min.css' | asset_url | stylesheet_tag }}
{{ 'custom-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cust-splide.min.js' | asset_url }}" defer></script>
<script src="{{ 'product-you-may-like.js' | asset_url }}" defer></script>
<script src="{{ 'custom-product-card.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign selected_products = block.settings.products
  assign mobile_per_page = block.settings.cards_mobile | plus: 0
  assign desktop_per_page = block.settings.cards_desktop | plus: 0
%}

<div
  class="product-you-may-like product-you-may-like--{{ block.id }}"
  style="--product-you-may-like-padding-top: {{ block.settings.padding_top }}px; --product-you-may-like-padding-bottom: {{ block.settings.padding_bottom }}px; --product-you-may-like-title-align: {{ block.settings.title_alignment }}; --product-card-column-gap: {{ settings.product_card_column_gap }}px; --product-card-row-gap: {{ settings.product_card_row_gap }}px;"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h2 class="product-you-may-like__title">{{ block.settings.title | escape }}</h2>
  {% endif %}

  {% if selected_products.count > 0 %}
    <div
      id="ProductYouMayLikeSlider-{{ block.id }}"
      class="product-you-may-like__slider splide"
      data-product-you-may-like
      data-splide='{"type":"slide","perPage":{{ desktop_per_page }},"perMove":1,"gap":"{{ settings.product_card_column_gap }}px","arrows":false,"pagination":false,"drag":true,"snap":true,"rewind":false,"keyboard":"focused","breakpoints":{"749":{"perPage":{{ mobile_per_page }},"gap":"{{ settings.product_card_column_gap }}px"}}}'
      aria-label="{{ block.settings.title | default: 'You may also like' | escape }}"
    >
      <div class="splide__track">
        <ul class="splide__list" role="list">
          {% for recommended_product in selected_products %}
            {% if recommended_product.id != closest.product.id %}
              <li class="product-you-may-like__slide splide__slide">
                {% render 'custom-collection-product-card', product: recommended_product %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  {% elsif request.design_mode %}
    <p class="product-you-may-like__empty">Select products to display in this carousel.</p>
  {% endif %}
</div>

{% stylesheet %}
  .product-you-may-like {
    width: 100%;
    min-width: 0;
    padding-block: var(--product-you-may-like-padding-top) var(--product-you-may-like-padding-bottom);
  }

  .product-you-may-like__title {
    margin: 0 0 12px;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-align: var(--product-you-may-like-title-align);
    text-transform: uppercase;
  }

  .product-you-may-like__slider {
    width: 100%;
    min-width: 0;
    cursor: grab;
  }

  .product-you-may-like__slider:active { cursor: grabbing; }
  .product-you-may-like__slide {
    min-width: 0;
    margin-bottom: var(--product-card-row-gap, 22px);
  }

  .product-you-may-like .custom-collection-card {
    width: 100%;
    font-size: 0.82rem;
  }

  .product-you-may-like .custom-collection-card__media {
    --custom-collection-image-ratio: 126%;
  }

  .product-you-may-like .custom-collection-card__content { padding: 6px; }

  .product-you-may-like .custom-collection-card__title {
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .product-you-may-like .custom-collection-card__price {
    gap: 3px;
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .product-you-may-like .custom-collection-card__quick-add-button {
    width: 30px;
    min-width: 30px;
    height: 30px;
    min-height: 30px;
  }

  .product-you-may-like .custom-collection-card__wishlist-wrap .wishlist-button {
    width: 28px;
    height: 28px;
  }

  .product-you-may-like__empty {
    margin: 0;
    color: rgb(var(--color-foreground-rgb, 31 31 31) / 0.65);
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "You may also like",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "You may also like"
    },
    {
      "type": "text_alignment",
      "id": "title_alignment",
      "label": "Title alignment",
      "default": "center"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "select",
      "id": "cards_desktop",
      "label": "Cards per view on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "cards_mobile",
      "label": "Cards per view on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "You may also like",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
