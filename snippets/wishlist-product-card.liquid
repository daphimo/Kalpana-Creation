{%- liquid
  assign card_image = product.featured_media.preview_image | default: product.featured_image
  assign current_variant = product.selected_or_first_available_variant
-%}

<article
  class="wishlist-product-card custom_card-product-card"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-available="{{ current_variant.available }}"
>
  <div class="wishlist-product-card__media">
    <a
      href="{{ product.url }}"
      class="wishlist-product-card__image-link"
      aria-label="{{ product.title | escape }}"
    >
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 900
          | image_tag:
            widths: '240, 360, 480, 640, 750, 900',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            loading: 'lazy',
            class: 'wishlist-product-card__image',
            alt: card_image.alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'wishlist-product-card__image wishlist-product-card__placeholder' }}
      {%- endif -%}
    </a>

    {% render 'wishlist-button', product: product, class: 'wishlist-product-card__wishlist' %}
  </div>

  <div class="wishlist-product-card__content">
    <h3 class="wishlist-product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="wishlist-product-card__price">
      {%- if product.price_varies -%}
        {%- assign minimum_price = product.price_min | money -%}
        <span class="wishlist-product-card__current-price">
          {{ 'content.price_from' | t: price: minimum_price }}
        </span>
      {%- else -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="wishlist-product-card__compare-price">
            {{ current_variant.compare_at_price | money }}
          </s>
        {%- endif -%}

        <span class="wishlist-product-card__current-price">
          {{ current_variant.price | money }}
        </span>
      {%- endif -%}
    </div>
  </div>
</article>
