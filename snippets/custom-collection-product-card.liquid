{%- liquid
  assign card_image = product.featured_media.preview_image | default: product.featured_image
  assign current_variant = product.selected_or_first_available_variant
  assign has_inventory = false
  assign sheet_variant = nil
  for variant in product.variants
    if variant.available
      if variant.inventory_management == blank or variant.inventory_quantity > 0
        assign has_inventory = true
        if sheet_variant == nil
          assign sheet_variant = variant
        endif
      endif
    endif
  endfor
  if sheet_variant == nil
    assign sheet_variant = current_variant
  endif
  assign compare_price = current_variant.compare_at_price
  assign current_price = current_variant.price
  assign discount_percent = 0
  if compare_price > current_price
    assign price_difference = compare_price | minus: current_price
    assign discount_percent = price_difference | times: 100.0 | divided_by: compare_price | round
  endif
-%}

<article class="custom-collection-card" data-product-id="{{ product.id }}">
  <div class="custom-collection-card__media">
    <a
      class="custom-collection-card__image-link"
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    >
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 1000
          | image_tag:
            class: 'custom-collection-card__image',
            widths: '240, 360, 480, 640, 800, 1000',
            sizes: '(max-width: 749px) 50vw, (max-width: 1199px) 33vw, 25vw',
            width: card_image.width,
            height: card_image.height,
            loading: 'lazy',
            alt: card_image.alt
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'custom-collection-card__image custom-collection-card__placeholder' }}
      {% endif %}
    </a>

    {% render 'wishlist-button', product: product, class: 'custom-collection-card__wishlist' %}

    {% if settings.best_seller_badge_image != blank and product.tags contains 'bestseller' %}
      <div
        class="custom-collection-card__best-seller"
        style="--best-seller-badge-width: {{ settings.best_seller_badge_width }}px; --best-seller-badge-fit: {{ settings.best_seller_badge_image_fit }};"
      >
        {{ settings.best_seller_badge_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: 'Best seller' }}
      </div>
    {% endif %}

    {% liquid
      assign card_rating = product.metafields.reviews.rating.value.rating
      assign card_rating_max = product.metafields.reviews.rating.value.scale_max
      assign card_rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
    %}
    {% if card_rating != blank %}
      <div class="custom-collection-card__rating" aria-label="{{ 'accessibility.rating' | t: rating: card_rating }}">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M31.547 12a.848.848 0 0 0-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 0 0-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 0 0-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 0 0 1.23.893l8.428-4.434 8.432 4.432a.847.847 0 0 0 1.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 0 0 .214-.869z"/></svg>
        <span>{{ card_rating | round: 1 }}</span>
        {% if card_rating_count != blank %}<small>({{ card_rating_count }})</small>{% endif %}
        <span class="visually-hidden">out of {{ card_rating_max }}</span>
      </div>
    {% endif %}

  </div>

  <div class="custom-collection-card__content">
    <div class="custom-collection-card__title-row">
      <h2 class="custom-collection-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h2>

      {% if product.has_only_default_variant %}
        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
          class="custom-collection-card__quick-add"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', product, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ current_variant.id }}" {% unless has_inventory %}disabled{% endunless %}>
            <input type="hidden" name="quantity" value="{% if current_variant.quantity_rule.min %}{{ current_variant.quantity_rule.min }}{% else %}1{% endif %}">
            {% render 'add-to-cart-button',
              add_to_cart_text: 'Add to cart',
              class: 'custom-collection-card__quick-add-button',
              can_add_to_cart: has_inventory,
              show_icon: true,
              icon_only: true,
              product: product,
              data_testid: 'custom-product-card-add-to-cart'
            %}
          {%- endform -%}
        </product-form-component>
      {% else %}
        <div class="custom-collection-card__quick-add">
          <button
            type="button"
            class="custom-collection-card__quick-add-button"
            aria-label="{% if has_inventory %}Choose options for {{ product.title | escape }}{% else %}{{ product.title | escape }} is sold out{% endif %}"
            aria-haspopup="dialog"
            aria-controls="ProductCardQuickAdd-{{ section.id }}-{{ product.id }}"
            data-card-quick-add-open
            {% unless has_inventory %}disabled{% endunless %}
          >
            <span aria-hidden="true">{{- 'icon-add-to-cart.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="custom-collection-card__price">
      {% if settings.currency_code_enabled_product_cards %}
        {% assign formatted_price = current_price | money_with_currency %}
        {% assign formatted_compare_price = compare_price | money_with_currency %}
      {% else %}
        {% assign formatted_price = current_price | money %}
        {% assign formatted_compare_price = compare_price | money %}
      {% endif %}

      <span class="custom-collection-card__current-price">{{ formatted_price }}</span>
      {% if compare_price > current_price %}
        <s class="custom-collection-card__compare-price">{{ formatted_compare_price }}</s>
        <span class="custom-collection-card__discount">{{ discount_percent }}% off</span>
      {% endif %}
    </div>
  </div>

  {% unless product.has_only_default_variant %}
    <dialog
      id="ProductCardQuickAdd-{{ section.id }}-{{ product.id }}"
      class="custom-collection-card__variant-dialog"
      data-card-variant-dialog
      aria-labelledby="ProductCardQuickAddTitle-{{ section.id }}-{{ product.id }}"
    >
      <div class="custom-collection-card__variant-sheet">
        <header class="custom-collection-card__variant-header">
          {% if sheet_variant.featured_image != blank %}
            {{ sheet_variant.featured_image | image_url: width: 160 | image_tag: class: 'custom-collection-card__variant-image', loading: 'lazy', alt: product.title }}
          {% elsif card_image != blank %}
            {{ card_image | image_url: width: 160 | image_tag: class: 'custom-collection-card__variant-image', loading: 'lazy', alt: product.title }}
          {% endif %}
          <div>
            <h3 id="ProductCardQuickAddTitle-{{ section.id }}-{{ product.id }}">{{ product.title | escape }}</h3>
            <p data-card-variant-price>{{ sheet_variant.price | money }}</p>
          </div>
          <button type="button" class="custom-collection-card__variant-close" data-card-quick-add-close aria-label="Close">&times;</button>
        </header>

        <div class="custom-collection-card__variant-options">
          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            <fieldset data-card-option-group data-option-index="{{ forloop.index0 }}">
              <legend>Select {{ option.name | escape }}</legend>
              <div>
                {% for value in option.values %}
                  <button
                    type="button"
                    data-card-option-value="{{ value | escape }}"
                    {% if sheet_variant.options[option_index] == value %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
                  >{{ value | escape }}</button>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>

        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
          class="custom-collection-card__variant-form"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', product, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ sheet_variant.id }}" data-card-variant-id>
            <input type="hidden" name="quantity" value="{% if sheet_variant.quantity_rule.min %}{{ sheet_variant.quantity_rule.min }}{% else %}1{% endif %}">
            {% render 'add-to-cart-button',
              add_to_cart_text: 'Add to cart',
              class: 'custom-collection-card__variant-submit',
              can_add_to_cart: true,
              show_icon: false,
              product: product,
              data_testid: 'custom-product-card-variant-add-to-cart'
            %}
          {%- endform -%}
        </product-form-component>

        <script type="application/json" data-card-variants>
          [
            {% for variant in product.variants %}
              {
                "id": {{ variant.id | json }},
                "inStock": {% if variant.available %}{% if variant.inventory_management == blank or variant.inventory_quantity > 0 %}true{% else %}false{% endif %}{% else %}false{% endif %},
                "options": {{ variant.options | json }},
                "price": {{ variant.price | money | json }},
                "image": {% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>
      </div>
    </dialog>
  {% endunless %}
</article>
