{% liquid
  assign whatsapp_number = section.settings.phone_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = section.settings.message | url_encode
  assign whatsapp_link = blank

  if section.settings.link_type == 'community'
    assign whatsapp_link = section.settings.community_link
  elsif whatsapp_number != blank
    assign whatsapp_link = 'https://wa.me/' | append: whatsapp_number
    if section.settings.message != blank
      assign whatsapp_link = whatsapp_link | append: '?text=' | append: whatsapp_message
    endif
  endif
%}

{% if whatsapp_link != blank %}
  <a
    class="floating-whatsapp floating-whatsapp--{{ section.settings.position }}"
    href="{{ whatsapp_link }}"
    {% if section.settings.link_target == 'new_tab' %}target="_blank" rel="noopener noreferrer"{% endif %}
    aria-label="{{ section.settings.accessibility_label | escape }}"
    style="
      --floating-whatsapp-size: {{ section.settings.icon_size }}px;
      --floating-whatsapp-bottom: {{ section.settings.bottom_offset }}px;
      --floating-whatsapp-side: {{ section.settings.side_offset }}px;
      --floating-whatsapp-background: {{ section.settings.background_color }};
      --floating-whatsapp-color: {{ section.settings.icon_color }};
    "
  >
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      {% render 'icon', icon: 'whatsapp' %}
    </svg>
  </a>
{% endif %}

{% stylesheet %}
  .floating-whatsapp {
    position: fixed;
    z-index: 39;
    bottom: var(--floating-whatsapp-bottom);
    display: grid;
    width: var(--floating-whatsapp-size);
    height: var(--floating-whatsapp-size);
    border-radius: 50%;
    place-items: center;
    background: var(--floating-whatsapp-background);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.2);
    color: var(--floating-whatsapp-color);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .floating-whatsapp--right { right: var(--floating-whatsapp-side); }
  .floating-whatsapp--left { left: var(--floating-whatsapp-side); }

  .floating-whatsapp svg {
    width: 58%;
    height: 58%;
    fill: currentColor;
  }

  .floating-whatsapp:hover {
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.26);
    transform: translateY(-2px);
  }

  .floating-whatsapp:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .floating-whatsapp,
    .floating-whatsapp-section {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Floating WhatsApp",
  "tag": "section",
  "class": "floating-whatsapp-section",
  "settings": [
    {
      "type": "select",
      "id": "link_type",
      "label": "WhatsApp link type",
      "options": [
        { "value": "mobile", "label": "Mobile number" },
        { "value": "community", "label": "Community link" }
      ],
      "default": "mobile"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp number",
      "info": "Include the country code, for example 919876543210."
    },
    {
      "type": "url",
      "id": "community_link",
      "label": "WhatsApp community link",
      "info": "Used when the WhatsApp link type is Community link."
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Pre-filled message",
      "default": "Hello, I would like to know more."
    },
    {
      "type": "select",
      "id": "link_target",
      "label": "Open link",
      "options": [
        { "value": "same_tab", "label": "Normally (same tab)" },
        { "value": "new_tab", "label": "In a new tab" }
      ],
      "default": "new_tab"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Chat with us on WhatsApp"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Button size",
      "min": 44,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "label": "Bottom offset",
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "Side offset",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Floating WhatsApp"
    }
  ]
}
{% endschema %}
