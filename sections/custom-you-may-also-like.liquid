{{ 'custom-collection.css' | asset_url | stylesheet_tag }}
{{ 'custom-featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-product-card.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'custom-product-discovery.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign recommendation_product = section.settings.product | default: product
  assign recommendation_products = recommendations.products
%}

<div class="section-background"></div>
<section
  id="CustomYouMayAlsoLike-{{ section.id }}"
  class="section section--page-width spacing-style custom-featured-collection custom-featured-collection--mobile-{{ section.settings.mobile_layout }}"
  data-you-may-also-like
  data-section-id="{{ section.id }}"
  data-product-id="{{ recommendation_product.id }}"
  data-product-limit="{{ section.settings.products_to_show }}"
  data-url="{{ routes.product_recommendations_url }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  {% unless recommendations.performed and recommendation_products.size > 0 %}hidden{% endunless %}
  style="
    --custom-featured-columns: {{ section.settings.columns_desktop }};
    --custom-featured-mobile-columns: {{ section.settings.columns_mobile }};
    --custom-featured-gap: {{ section.settings.grid_gap }}px;
    --custom-collection-image-ratio: {{ section.settings.image_ratio }}%;
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="custom-featured-collection__inner">
    {% if section.settings.heading != blank %}
      <h2 class="custom-featured-collection__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <ul class="custom-featured-collection__products" data-recommendation-list role="list">
      {% if recommendations.performed %}
        {% for product in recommendation_products limit: section.settings.products_to_show %}
          <li class="custom-featured-collection__item">
            {% render 'custom-collection-product-card', product: product %}
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "You may also like custom",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the current product." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2", "visible_if": "{{ section.settings.mobile_layout == 'grid' }}" },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "options": [{ "value": "grid", "label": "Grid" }, { "value": "slide", "label": "Swipe" }], "default": "slide" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "image_ratio", "label": "Image height ratio", "min": 110, "max": 150, "step": 5, "unit": "%", "default": 135 },
    { "type": "range", "id": "padding-block-start", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "You may also like custom" }]
}
{% endschema %}
