{% unless template.name == 'index' %}
  {% liquid
    case template.name
      when 'product'
        assign mobile_page_title = product.title
      when 'collection'
        assign mobile_page_title = collection.title
      when 'page'
        assign mobile_page_title = page.title
      when 'blog'
        assign mobile_page_title = blog.title
      when 'article'
        assign mobile_page_title = article.title
      when 'cart'
        assign mobile_page_title = 'Cart'
      when 'search'
        assign mobile_page_title = 'Search'
      when 'list-collections'
        assign mobile_page_title = 'Collections'
      when '404'
        assign mobile_page_title = 'Page not found'
      when 'customers/account'
        assign mobile_page_title = 'Account'
      when 'customers/addresses'
        assign mobile_page_title = 'Addresses'
      when 'customers/login'
        assign mobile_page_title = 'Log in'
      when 'customers/register'
        assign mobile_page_title = 'Create account'
      when 'customers/order'
        assign mobile_page_title = 'Order'
      when 'customers/reset_password'
        assign mobile_page_title = 'Reset password'
      when 'customers/activate_account'
        assign mobile_page_title = 'Activate account'
      else
        assign mobile_page_title = page_title | default: shop.name
    endcase

    assign mobile_page_title = mobile_page_title | strip
    assign title_length = mobile_page_title | size
    if title_length > 18
      assign mobile_page_title = mobile_page_title | slice: 0, 18 | append: '...'
    endif
    assign wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist'
  %}

  <div
    id="MobilePageHeader-{{ section.id }}"
    class="mobile-page-header"
    style="--mobile-page-header-padding-top: {{ section.settings.padding_top }}px; --mobile-page-header-padding-bottom: {{ section.settings.padding_bottom }}px;"
    data-mobile-page-header
  >
    <div class="mobile-page-header__inner">
      <button type="button" class="mobile-page-header__button mobile-page-header__back" aria-label="Go back" data-mobile-page-header-back>
        <span class="mobile-page-header__back-icon" aria-hidden="true">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>

      <span class="mobile-page-header__title" title="{{ page_title | escape }}">{{ mobile_page_title | escape }}</span>

      <div class="mobile-page-header__actions">
        <button
          type="button"
          class="mobile-page-header__button mobile-page-header__search button-unstyled"
          on:click="#search-modal/showDialog"
          aria-label="{{ 'content.search_input_label' | t }}"
          aria-haspopup="dialog"
        >
          {{- 'icon-search.svg' | inline_asset_content -}}
        </button>

        <a
          class="mobile-page-header__button mobile-page-header__wishlist swym-wishlist wishlist-link"
          href="{{ wishlist_url }}"
          aria-label="Wishlist"
        >
          {% render 'wishlist-header' %}
        </a>
      </div>
    </div>
  </div>
  <div class="mobile-page-header__spacer" aria-hidden="true" data-mobile-page-header-spacer></div>

  {% style %}
    #MobilePageHeader-{{ section.id }} {
      position: fixed;
      z-index: 40;
      top: 0;
      right: 0;
      left: 0;
      width: 100%;
      padding-top: calc(var(--mobile-page-header-padding-top) + env(safe-area-inset-top, 0px));
      padding-bottom: var(--mobile-page-header-padding-bottom);
      border-bottom: 1px solid rgb(var(--color-foreground-rgb, 48 42 39) / 0.12);
      background: var(--color-background, #fff);
      color: var(--color-foreground, #302a27);
      box-shadow: 0 1px 4px rgb(0 0 0 / 0.04);
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__inner {
      display: flex;
      width: 100%;
      align-items: center;
      gap: 6px;
      padding-inline: 10px;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__button {
      display: grid;
      width: 44px;
      min-width: 44px;
      min-height: 44px;
      padding: 10px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: inherit;
      cursor: pointer;
      place-items: center;
      text-decoration: none;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__button:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: -3px;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__back-icon,
    #MobilePageHeader-{{ section.id }} .mobile-page-header__button > svg {
      display: block;
      width: 22px;
      height: 22px;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__back-icon {
      transform: rotate(180deg);
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__back-icon svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__title {
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
      font: inherit;
      font-weight: 500;
      line-height: 1.25;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__actions {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 2px;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__wishlist .wishlist-icon-container,
    #MobilePageHeader-{{ section.id }} .mobile-page-header__wishlist .wishlist-icon-container > svg {
      display: block;
      width: 22px;
      height: 22px;
    }

    #MobilePageHeader-{{ section.id }} .mobile-page-header__wishlist .wishlist-icon-container > svg path {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.5;
    }

    #MobilePageHeader-{{ section.id }} .wishlist-count-bubble {
      display: none !important;
    }
  {% endstyle %}

  <script>
    (() => {
      const header = document.getElementById('MobilePageHeader-{{ section.id }}');
      const spacer = header?.nextElementSibling;
      if (!header || !spacer?.hasAttribute('data-mobile-page-header-spacer')) return;

      const updateSpacer = () => {
        spacer.style.height = window.matchMedia('(max-width: 749px)').matches
          ? `${header.getBoundingClientRect().height}px`
          : '0px';
      };

      header.querySelector('[data-mobile-page-header-back]')?.addEventListener('click', () => window.history.back());
      new ResizeObserver(updateSpacer).observe(header);
      window.matchMedia('(max-width: 749px)').addEventListener('change', updateSpacer);
      updateSpacer();
    })();
  </script>
{% endunless %}

{% schema %}
{
  "name": "Mobile page header",
  "tag": "section",
  "class": "mobile-page-header-section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist URL"
    }
  ],
  "presets": [
    {
      "name": "Mobile page header"
    }
  ]
}
{% endschema %}
