{% liquid
  assign has_payment_icons = false
  assign payment_icon_sizes = section.settings.icon_width | append: 'px'

  for block in section.blocks
    if block.settings.image != blank
      assign has_payment_icons = true
      break
    endif
  endfor
%}

{% if has_payment_icons or request.design_mode %}
  <div
    class="manual-payment-icons section section--{{ section.settings.section_width }}"
    style="
      --manual-payment-icon-width: {{ section.settings.icon_width }}px;
      --manual-payment-icon-gap: {{ section.settings.icon_gap }}px;
      --manual-payment-icons-alignment: {{ section.settings.alignment }};
      --manual-payment-heading-alignment: {{ section.settings.heading_alignment }};
      --manual-payment-padding-top: {{ section.settings.padding_top }}px;
      --manual-payment-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% if has_payment_icons %}
      {% if section.settings.heading != blank %}
        <h2 class="manual-payment-icons__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <ul class="manual-payment-icons__list" role="list">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            {% liquid
              assign image_alt = block.settings.alt_text
              if image_alt == blank
                assign image_alt = block.settings.image.alt
              endif
            %}
            <li class="manual-payment-icons__item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag:
                  class: 'manual-payment-icons__image',
                  widths: '40, 60, 80, 100, 120, 160, 200',
                  sizes: payment_icon_sizes,
                  alt: image_alt,
                  loading: 'lazy'
              }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% else %}
      <p class="manual-payment-icons__placeholder">
        Add payment icon blocks to display your payment methods.
      </p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .manual-payment-icons {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding-block: var(--manual-payment-padding-top) var(--manual-payment-padding-bottom);
  }

  .manual-payment-icons__heading {
    margin: 0 0 var(--gap-sm);
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: var(--font-h6--size);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    line-height: var(--font-heading--line-height);
    text-align: var(--manual-payment-heading-alignment);
  }

  .manual-payment-icons__list {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    justify-content: var(--manual-payment-icons-alignment);
    flex-wrap: wrap;
    gap: var(--manual-payment-icon-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .manual-payment-icons__item {
    display: flex;
    max-width: 100%;
    align-items: center;
    flex: 0 1 auto;
  }

  .manual-payment-icons__image {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, var(--manual-payment-icon-width));
    max-height: var(--manual-payment-icon-width);
    object-fit: contain;
  }

  .manual-payment-icons__placeholder {
    margin: 0;
    padding: var(--gap-md);
    border: 1px dashed currentColor;
    color: inherit;
    font-family: var(--font-body--family);
    text-align: center;
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .manual-payment-icons__list {
      row-gap: var(--manual-payment-icon-gap);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Manual payment icons",
  "class": "manual-payment-icons-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Payment heading",
      "placeholder": "We accept"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon width",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Icon gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Icon alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "payment_icon",
      "name": "Payment icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text",
          "info": "Leave blank to use the image's alt text. If both are blank, the image is treated as decorative."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manual payment icons",
      "category": "Footer",
      "blocks": [
        { "type": "payment_icon" },
        { "type": "payment_icon" },
        { "type": "payment_icon" }
      ]
    }
  ]
}
{% endschema %}
