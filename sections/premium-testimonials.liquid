{{ 'cust-splide-core.min.css' | asset_url | stylesheet_tag }}
{{ 'premium-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'premium-testimonials.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% render 'brand-colors' %}

{% liquid
  assign section_class = 'premium-testimonials'
  if section.settings.section_width == 'contained'
    assign section_class = section_class | append: ' section section--page-width'
  endif
  capture slider_options
    echo '{"type":"slide","perPage":'
    echo section.settings.slides_per_view_desktop | default: 3
    echo ',"perMove":1,"gap":"'
    echo settings.product_card_column_gap | default: 16
    echo 'px","arrows":'
    echo section.settings.show_navigation
    echo ',"pagination":'
    echo section.settings.show_pagination
    echo ',"autoplay":'
    echo section.settings.autoplay
    echo ',"interval":'
    echo section.settings.autoplay_speed | times: 1000
    echo ',"pauseOnHover":true,"pauseOnFocus":true,"drag":true,"snap":true,"rewind":true,"keyboard":"focused","speed":450,"breakpoints":{"749":{"perPage":'
    echo section.settings.slides_per_view_mobile | default: 1
    echo ',"gap":"12px"}},"reducedMotion":{"speed":0,"rewindSpeed":0,"autoplay":"pause"}}'
  endcapture
  capture slider_data_attribute
    echo 'data-premium-testimonials data-splide-asset="'
    echo 'cust-splide.min.js' | asset_url
    echo '"'
  endcapture
%}

{% capture testimonial_slides %}
  {% for block in section.blocks %}
    {% liquid
      assign card_tag = 'div'
      if block.settings.product != blank
        assign card_tag = 'a'
      endif
      assign image_alt = block.settings.image.alt | default: block.settings.customer_name
    %}
    <li class="splide__slide premium-testimonials__slide" {{ block.shopify_attributes }}>
      <{{ card_tag }}
        class="premium-testimonials__card premium-testimonials__card--align-{{ block.settings.card_alignment }}"
        {% if block.settings.product != blank %}href="{{ block.settings.product.url }}"{% endif %}
      >
        {% if block.settings.image != blank %}
          <div class="premium-testimonials__image">
            {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '240, 360, 480, 750, 1000, 1200, 1600', sizes: '(max-width: 749px) 100vw, (max-width: 1200px) 75vw, 1000px', loading: 'lazy', alt: image_alt }}
          </div>
        {% endif %}
        <div class="premium-testimonials__body">
          <div class="premium-testimonials__header">
            <div class="premium-testimonials__customer">
              {% if block.settings.customer_name != blank %}<p class="premium-testimonials__name">{{ block.settings.customer_name | escape }}</p>{% endif %}
              <div class="premium-testimonials__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                {% for star in (1..5) %}<span{% if star > block.settings.rating %} class="is-empty"{% endif %} aria-hidden="true">★</span>{% endfor %}
              </div>
            </div>
          </div>
          <div class="premium-testimonials__copy">
            {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
            {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
          </div>
        </div>
      </{{ card_tag }}>
    </li>
  {% endfor %}
{% endcapture %}

<section
  id="PremiumTestimonials-{{ section.id }}"
  class="{{ section_class }} spacing-style"
  data-premium-testimonials-section
  style="--testimonial-image-height: {{ section.settings.image_height }}px; --testimonial-heading-align: {{ section.settings.heading_alignment }}; {% render 'spacing-style', settings: section.settings %}"
>
  <div class="premium-testimonials__inner{% if section.settings.section_width == 'full' %} premium-testimonials__inner--full{% endif %}">
    <header class="premium-testimonials__heading-wrap">
      {% if section.settings.eyebrow != blank %}<p class="premium-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="premium-testimonials__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      {% render 'splide-slider',
        slider_id: 'PremiumTestimonialsSlider-' | append: section.id,
        class: 'premium-testimonials__slider',
        data_attribute: slider_data_attribute,
        aria_label: section.settings.heading,
        splide_options: slider_options,
        slides_markup: testimonial_slides
      %}
    {% elsif request.design_mode %}
      <p class="premium-testimonials__empty">Add testimonial blocks to build the slider.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Premium testimonials",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discover how we're making a difference, one outfit at a time." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See why everyone loves Kalpana's Creations." },
    { "type": "text_alignment", "id": "heading_alignment", "label": "Heading alignment", "default": "center" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{"value":"contained","label":"Contained"},{"value":"full","label":"Full width"}], "default": "contained" },
    { "type": "header", "content": "Slider" },
    { "type": "range", "id": "slides_per_view_desktop", "label": "Slides per view on desktop", "min": 1, "max": 5, "step": 0.5, "default": 3 },
    { "type": "range", "id": "slides_per_view_mobile", "label": "Slides per view on mobile", "min": 1, "max": 3, "step": 0.5, "default": 1 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 1, "max": 10, "step": 0.5, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": false },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 100, "max": 600, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "padding-block-start", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Priya Sharma" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Testimonial title", "default": "Beautifully made and effortless to wear" },
        { "type": "richtext", "id": "description", "label": "Testimonial description", "default": "<p>The fabric, finish and thoughtful detailing exceeded my expectations. It felt special from the moment I opened the package.</p>" },
        { "type": "image_picker", "id": "image", "label": "Customer or product image" },
        { "type": "product", "id": "product", "label": "Linked product" },
        { "type": "select", "id": "card_alignment", "label": "Card content alignment", "options": [{"value":"top","label":"Top"},{"value":"center","label":"Center"}], "default": "top" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "customer_name": "Priya Sharma", "title": "Beautifully made and effortless to wear", "description": "<p>The fabric and finish exceeded my expectations. Every detail feels considered and special.</p>" } },
        { "type": "testimonial", "settings": { "customer_name": "Ananya Mehta", "title": "My new celebration favourite", "description": "<p>Elegant, comfortable and even more beautiful in person. I received compliments all evening.</p>" } },
        { "type": "testimonial", "settings": { "customer_name": "Kavya Rao", "title": "Luxury in every detail", "description": "<p>From the thoughtful packaging to the graceful silhouette, the entire experience felt exceptional.</p>" } },
        { "type": "testimonial", "settings": { "customer_name": "Meera Patel", "title": "A piece I will treasure", "description": "<p>The craftsmanship is remarkable and the fit feels as though it was made especially for me.</p>" } }
      ]
    }
  ]
}
{% endschema %}
