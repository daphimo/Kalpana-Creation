{{ 'section-title.css' | asset_url | stylesheet_tag }}

{% liquid
  case section.settings.grid_per_mobile
    when 1
      assign mobile_image_size = 'calc(100vw - 32px)'
    when 1.5
      assign mobile_image_size = 'calc((100vw - 44px) / 1.5)'
    when 2
      assign mobile_image_size = 'calc((100vw - 44px) / 2)'
    when 2.5
      assign mobile_image_size = 'calc((100vw - 56px) / 2.5)'
    when 3
      assign mobile_image_size = 'calc((100vw - 56px) / 3)'
    when 3.5
      assign mobile_image_size = 'calc((100vw - 68px) / 3.5)'
    else
      assign mobile_image_size = 'calc((100vw - 68px) / 4)'
  endcase

  case section.settings.grid_per_desktop
    when 1
      assign desktop_image_size = '100vw'
    when 2
      assign desktop_image_size = '50vw'
    when 3
      assign desktop_image_size = '34vw'
    when 4
      assign desktop_image_size = '25vw'
    when 5
      assign desktop_image_size = '20vw'
    when 6
      assign desktop_image_size = '17vw'
    when 7
      assign desktop_image_size = '15vw'
    else
      assign desktop_image_size = '13vw'
  endcase

  assign grid_image_sizes = '(max-width: 749px) ' | append: mobile_image_size | append: ', ' | append: desktop_image_size
%}

<section
  id="ResponsiveFlexGrid-{{ section.id }}"
  class="section section--page-width spacing-style responsive-flex-grid responsive-flex-grid--{{ section.settings.mobile_layout }}"
  style="
    --grid-columns-desktop: {{ section.settings.grid_per_desktop }};
    --grid-columns-mobile: {{ section.settings.grid_per_mobile }};
    --grid-column-gap: {{ settings.product_card_column_gap }}px;
    --grid-row-gap: {{ settings.product_card_row_gap }}px;
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {% if section.settings.section_title != blank %}
    {% render 'section-title', title: section.settings.section_title, tag: section.settings.heading_tag, size: section.settings.heading_size, class: 'responsive-flex-grid__heading' %}
  {% endif %}

  <div class="responsive-flex-grid__container">
    {% for block in section.blocks %}
      {% liquid
        assign image_alt = block.settings.image.alt | default: block.settings.title
      %}

      {% if block.settings.link != blank %}
        <a
          class="responsive-flex-grid__item"
          href="{{ block.settings.link }}"
          {{ block.shopify_attributes }}
        >
          <div class="responsive-flex-grid__image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 960
                | image_tag:
                  class: 'responsive-flex-grid__image',
                  widths: '160, 240, 320, 360, 480, 640, 720, 960',
                  sizes: grid_image_sizes,
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  alt: image_alt,
                  loading: 'lazy',
                  decoding: 'async'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'responsive-flex-grid__placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="responsive-flex-grid__title">{{ block.settings.title | escape }}</p>
          {% endif %}
        </a>
      {% else %}
        <div
          class="responsive-flex-grid__item"
          {{ block.shopify_attributes }}
        >
          <div class="responsive-flex-grid__image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 960
                | image_tag:
                  class: 'responsive-flex-grid__image',
                  widths: '160, 240, 320, 360, 480, 640, 720, 960',
                  sizes: grid_image_sizes,
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  alt: image_alt,
                  loading: 'lazy',
                  decoding: 'async'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'responsive-flex-grid__placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="responsive-flex-grid__title">{{ block.settings.title | escape }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% style %}
  #ResponsiveFlexGrid-{{ section.id }} {
    width: 100%;
    overflow: hidden;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--grid-column-gap);
    row-gap: var(--grid-row-gap);
    width: 100%;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__heading {
    color: inherit;
    text-align: center;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__item {
    display: flex;
    flex: 0 0 calc(
      (100% - (var(--grid-column-gap) * (var(--grid-columns-desktop) - 1))) / var(--grid-columns-desktop)
    );
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  #ResponsiveFlexGrid-{{ section.id }} a.responsive-flex-grid__item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__image,
  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__title {
    margin: 10px 0 0;
    color: inherit;
    font-family: inherit;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container::-webkit-scrollbar {
      display: none;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__item {
      flex-basis: calc(
        (100% - (var(--grid-column-gap) * (var(--grid-columns-mobile) - 1))) / var(--grid-columns-mobile)
      );
      flex-shrink: 0;
    }

    #ResponsiveFlexGrid-{{ section.id }}.responsive-flex-grid--stack .responsive-flex-grid__container {
      flex-wrap: wrap;
      overflow-x: hidden;
      overscroll-behavior-inline: auto;
      touch-action: auto;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__title {
      margin-top: 8px;
      font-size: 1.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Responsive flex grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "grid_per_desktop",
      "label": "Grid per desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_per_mobile",
      "label": "Grid per mobile",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 2.5
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Block arrangement",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "stack",
          "label": "Stack"
        }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Responsive flex grid",
      "blocks": [
        { "type": "image_block", "settings": { "title": "New arrivals" } },
        { "type": "image_block", "settings": { "title": "Sarees" } },
        { "type": "image_block", "settings": { "title": "Occasion wear" } },
        { "type": "image_block", "settings": { "title": "Best sellers" } }
      ]
    }
  ]
}
{% endschema %}
