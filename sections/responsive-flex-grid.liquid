<section
  id="ResponsiveFlexGrid-{{ section.id }}"
  class="responsive-flex-grid responsive-flex-grid--{{ section.settings.mobile_layout }}"
  style="
    --grid-columns-desktop: {{ section.settings.grid_per_desktop }};
    --grid-columns-mobile: {{ section.settings.grid_per_mobile }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --grid-gap: 12px;
  "
>
  {% if section.settings.section_title != blank %}
    <h2 class="responsive-flex-grid__heading">
      {{ section.settings.section_title | escape }}
    </h2>
  {% endif %}

  <div class="responsive-flex-grid__container">
    {% for block in section.blocks %}
      {% liquid
        assign image_alt = block.settings.image.alt | default: block.settings.title
      %}

      {% if block.settings.link != blank %}
        <a
          class="responsive-flex-grid__item"
          href="{{ block.settings.link }}"
          {{ block.shopify_attributes }}
        >
          <div class="responsive-flex-grid__image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'responsive-flex-grid__image',
                  widths: '240, 360, 480, 720, 960, 1200',
                  sizes: '(max-width: 749px) 70vw, 25vw',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  alt: image_alt,
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'responsive-flex-grid__placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="responsive-flex-grid__title">{{ block.settings.title | escape }}</p>
          {% endif %}
        </a>
      {% else %}
        <div
          class="responsive-flex-grid__item"
          {{ block.shopify_attributes }}
        >
          <div class="responsive-flex-grid__image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'responsive-flex-grid__image',
                  widths: '240, 360, 480, 720, 960, 1200',
                  sizes: '(max-width: 749px) 70vw, 25vw',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  alt: image_alt,
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'responsive-flex-grid__placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.title != blank %}
            <p class="responsive-flex-grid__title">{{ block.settings.title | escape }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% style %}
  #ResponsiveFlexGrid-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    overflow: hidden;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grid-gap);
    width: 100%;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__heading {
    margin: 0 0 20px;
    color: inherit;
    font-family: inherit;
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__item {
    display: flex;
    flex: 0 0 calc(
      (100% - (var(--grid-gap) * (var(--grid-columns-desktop) - 1))) / var(--grid-columns-desktop)
    );
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  #ResponsiveFlexGrid-{{ section.id }} a.responsive-flex-grid__item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__image,
  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__title {
    margin: 10px 0 0;
    color: inherit;
    font-family: inherit;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__heading {
      margin-bottom: 16px;
      font-size: 2rem;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__container::-webkit-scrollbar {
      display: none;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__item {
      flex-basis: calc(
        (100% - (var(--grid-gap) * (var(--grid-columns-mobile) - 1))) / var(--grid-columns-mobile)
      );
      flex-shrink: 0;
    }

    #ResponsiveFlexGrid-{{ section.id }}.responsive-flex-grid--stack .responsive-flex-grid__container {
      flex-wrap: wrap;
      overflow-x: hidden;
      overscroll-behavior-inline: auto;
      touch-action: auto;
    }

    #ResponsiveFlexGrid-{{ section.id }} .responsive-flex-grid__title {
      margin-top: 8px;
      font-size: 1.2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Responsive flex grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Shop by collection"
    },
    {
      "type": "range",
      "id": "grid_per_desktop",
      "label": "Grid per desktop",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_per_mobile",
      "label": "Grid per mobile",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 2.5
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Block arrangement",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "stack",
          "label": "Stack"
        }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Responsive flex grid",
      "blocks": [
        { "type": "image_block", "settings": { "title": "New arrivals" } },
        { "type": "image_block", "settings": { "title": "Sarees" } },
        { "type": "image_block", "settings": { "title": "Occasion wear" } },
        { "type": "image_block", "settings": { "title": "Best sellers" } }
      ]
    }
  ]
}
{% endschema %}
